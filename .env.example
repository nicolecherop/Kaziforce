DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DATABASE_ENGINE=postgresql
POSTGRES_DB=kaziforce
POSTGRES_USER=kaziforce_app
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_TEST_DB=test_kaziforce

# Debug mode prints password-reset messages in the server console.
# For real delivery, configure these settings and choose the SMTP backend.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=KaziForce <noreply@your-domain>

# Enable only after verifying real SMTP delivery. Existing enrolled accounts
# still require their code if delivery becomes unavailable.
EMAIL_TWO_STEP_ENABLED=false
# Google Cloud OAuth client: Web application, basic identity scopes only.
# Authorized callback for this local server:
# http://127.0.0.1:8001/accounts/auth/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
